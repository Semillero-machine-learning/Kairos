# Copia este archivo a .env y completa los valores. El .env nunca se sube al repositorio.

# Base de datos.
# Produccion (Supabase): usar el agrupador en el puerto 6543, no la conexion directa 5432.
#   DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Desarrollo local:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/kairos_dev

# JWT
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Correo (Resend). Si RESEND_API_KEY queda vacio, los correos se registran en el log y no se envian.
RESEND_API_KEY=
EMAIL_FROM=Semillero ML <notificaciones@send.kairospartners.uk>

# Enlaces que aparecen en los correos
FRONTEND_URL=https://app.kairospartners.uk

# Secreto compartido del proceso programado de recordatorios
JOB_TOKEN=cambia-esto-por-otra-cadena-larga-y-aleatoria

# CORS: lista separada por comas de origenes permitidos
CORS_ORIGINS=http://localhost:4200,https://app.kairospartners.uk

# production | development
ENVIRONMENT=development
